# Never commit a real .env file.
SECRET_KEY=replace-with-a-long-random-value
# Use DATABASE_URL instead of PETSTOCK_DB when running as a Vercel Function.
# Example: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=
PETSTOCK_DB=/data/petstock.db
REQUIRE_SECRET_KEY=1
GUNICORN_WORKERS=1
